 void loginfo(spdlog::logger* logger, std::string msg) { logger->info(msg); }
 
+// ---- Generic wrappers (required for WASM/Emscripten: AS_MAX_PORTABILITY) -----
+// AngelScript's native calling conventions cast function pointers between
+// incompatible types at call-time.  In WASM every indirect call is type-checked,
+// so those casts produce RuntimeError: function signature mismatch.
+// asCALL_GENERIC uses a known (asIScriptGeneric*)->void signature throughout.
+
+static void par_gen(asIScriptGeneric* gen) {
+	static_cast<lp::doc::Document*>(gen->GetAuxiliary())->writeParagraph();
+}
+static void pushFont_gen(asIScriptGeneric* gen) {
+	std::string s = *static_cast<std::string*>(gen->GetArgObject(0));
+	static_cast<lp::doc::Document*>(gen->GetAuxiliary())->pushFont(s);
+}
+static void popFont_gen(asIScriptGeneric* gen) {
+	static_cast<lp::doc::Document*>(gen->GetAuxiliary())->popFont();
+}
+static void writeString_gen(asIScriptGeneric* gen) {
+	std::string s = *static_cast<std::string*>(gen->GetArgObject(0));
+	writeString(static_cast<lp::doc::Document*>(gen->GetAuxiliary()), s);
+}
+static void writeGlue_gen(asIScriptGeneric* gen) {
+	int a = gen->GetArgDWord(0), b = gen->GetArgDWord(1), c = gen->GetArgDWord(2);
+	writeGlue(static_cast<lp::doc::Document*>(gen->GetAuxiliary()), a, b, c);
+}
+static void loginfo_gen(asIScriptGeneric* gen) {
+	std::string s = *static_cast<std::string*>(gen->GetArgObject(0));
+	loginfo(static_cast<spdlog::logger*>(gen->GetAuxiliary()), s);
+}
+static void glue_construct_gen(asIScriptGeneric* gen) {
+	abort(); /** \todo implement **/
+}
+static void glue_destruct_gen(asIScriptGeneric*) { /* no-op */ }
+static void string_from_parser_gen(asIScriptGeneric* gen) {
+	auto* self   = static_cast<std::string*>(gen->GetObject());
+	auto* parser = static_cast<lp::LPParser*>(gen->GetArgAddress(0));
+	new (self) std::string{parser->readBetween('{', '}')};
+}
+static void noop_gen(asIScriptGeneric*) {}
+// ---- End generic wrappers ---------------------------------------------------

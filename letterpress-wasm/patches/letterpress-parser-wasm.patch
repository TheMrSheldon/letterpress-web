+			// libc++ std::regex_search with bidirectional iterators calls std::distance(begin,end)
+			// internally, iterating until begin==end.  Our end sentinel (parser==nullptr) never
+			// compares equal to a live begin iterator, so this loops until the heap is exhausted.
+			// Fix: snapshot the lookahead buffer into a std::string and use the string overload,
+			// which uses random-access iterators and avoids the infinite-iteration problem.
+			static const size_t CHUNK = 4096;
+			for (size_t i = lookAheadBuffer.size(); i < CHUNK; ++i) {
+				char c;
+				stream.read(&c, 1);
+				if (!stream) break;
+				lookAheadBuffer.push_back(c);
+			}
+			std::string view(lookAheadBuffer.begin(), lookAheadBuffer.end());
+			std::smatch m;
+			bool match = std::regex_search(view, m, regex, std::regex_constants::match_continuous);
+			return match ? (size_t)m.length() : 0;
 		}
